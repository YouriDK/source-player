<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cleartext HTTP is allowed because the app talks to Sonos speakers, Chromecast
        receivers, and the in-app local audio server over LAN IPs (e.g. 192.168.1.x:1400).

        Android's <domain> element only matches DNS hostnames, never IP literals or CIDR
        ranges, so there is no way to whitelist "private LAN only" here. All other network
        calls in the app (Last.fm, etc.) already use HTTPS.
    -->
    <base-config cleartextTrafficPermitted="true" />

    <!--
        Freebox OS API. LAN: mafreebox.freebox.fr (api_version discovery and API calls
        over HTTP; HTTPS validated against the Freebox CAs when used). Remote:
        *.fbxos.fr over HTTPS only, validated against the two Freebox Root CAs (the
        box's certificate is not issued by a public CA).
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">mafreebox.freebox.fr</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/freebox_root_ca" />
            <certificates src="@raw/freebox_ecc_root_ca" />
        </trust-anchors>
    </domain-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">fbxos.fr</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/freebox_root_ca" />
            <certificates src="@raw/freebox_ecc_root_ca" />
        </trust-anchors>
    </domain-config>
</network-security-config>
